import React, { useEffect, useState } from 'react'
import { useNavigate } from 'react-router-dom'
import {
  LayoutDashboard, ShoppingBag, ChefHat, CheckCircle2, BarChart3,
  Clock, FileText, Printer, GlassWater,
  FileSpreadsheet, User, LogOut, Menu, MessageSquare, Save, ArrowLeft
} from 'lucide-react'
import { fetchReceiptSettings, saveReceiptSettings } from '../../api/endpoints'

const SETTING_GROUPS = [
  {
    label: 'Business Information',
    settings: [
      { key: 'showBusinessName', label: 'Business Name' },
      { key: 'showDescription', label: 'Business Description' },
      { key: 'showAddress', label: 'Address / Location' },
      { key: 'showPhone', label: 'Phone Number' },
      { key: 'showEmail', label: 'Email Address' },
      { key: 'showTin', label: 'TIN Number' },
    ],
  },
  {
    label: 'Order Details',
    settings: [
      { key: 'showReceiptNo', label: 'Receipt Number' },
      { key: 'showDate', label: 'Date' },
      { key: 'showTime', label: 'Time' },
      { key: 'showWaiter', label: 'Waiter Name' },
      { key: 'showTable', label: 'Table Number' },
      { key: 'showOrderType', label: 'Order Type' },
      { key: 'showClientName', label: 'Client Name' },
      { key: 'showClientPhone', label: 'Client Phone' },
    ],
  },
  {
    label: 'Items & Totals',
    settings: [
      { key: 'showItems', label: 'Order Items' },
      { key: 'showSubtotal', label: 'Subtotal' },
      { key: 'showDiscount', label: 'Discount' },
      { key: 'showTotal', label: 'Total' },
    ],
  },
  {
    label: 'Payment Info',
    settings: [
      { key: 'showPaymentMethod', label: 'Payment Method' },
      { key: 'showAmountPaid', label: 'Amount Paid' },
      { key: 'showPaymentRef', label: 'Payment Reference' },
      { key: 'showPaymentStatus', label: 'Payment Status' },
      { key: 'showCustomerNumber', label: 'Customer Number' },
    ],
  },
  {
    label: 'Footer',
    settings: [
      { key: 'showFooterNote', label: 'Footer Note' },
    ],
  },
]

function SidebarLink({ icon, label, active, onClick }) {
  return (
    <a href="#" onClick={(e) => { e.preventDefault(); onClick?.() }} className={`flex items-center justify-between px-3 py-2 rounded-lg hover:bg-slate-800/60 hover:text-white transition group ${active ? 'font-medium' : ''} text-slate-400`}>
      <div className="flex items-center gap-3">
        <span className={active ? 'text-slate-400' : 'text-slate-500 group-hover:text-slate-300'}>{icon}</span>
        <span className="font-medium">{label}</span>
      </div>
    </a>
  )
}

export default function OperatorReceiptSettings() {
  const navigate = useNavigate()
  const [settings, setSettings] = useState(null)
  const [saving, setSaving] = useState(false)
  const [saved, setSaved] = useState(false)

  useEffect(() => {
    fetchReceiptSettings().then(setSettings).catch(() => setSettings(null))
  }, [])

  const toggle = (key) => {
    setSettings((prev) => ({ ...prev, [key]: !prev[key] }))
    setSaved(false)
  }

  const handleSave = async () => {
    setSaving(true)
    try {
      await saveReceiptSettings(settings)
      setSaved(true)
      setTimeout(() => setSaved(false), 2500)
    } catch (e) {
      console.error(e)
    } finally {
      setSaving(false)
    }
  }

  if (!settings) {
    return <div style={{ padding: 40, textAlign: 'center', color: '#6c757d' }}>Loading receipt settings…</div>
  }

  return (
    <div className="flex min-h-screen bg-slate-50 text-slate-800 font-sans antialiased">
      {/* SIDEBAR */}
      <aside className="w-64 bg-[#0B132B] text-slate-400 flex flex-col justify-between shrink-0">
        <div>
          <div className="h-16 flex items-center gap-2 px-6 border-b border-slate-800 text-white font-bold text-xl">
            <div className="p-1.5 bg-blue-600 rounded-lg text-white">
              <GlassWater size={20} className="transform rotate-180" />
            </div>
            <span>BarFlow</span>
          </div>

          <nav className="p-4 space-y-6 text-sm">
            <div>
              <p className="px-3 text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Order Management</p>
              <div className="space-y-1">
                <SidebarLink icon={<FileText size={18} />} label="New Orders" onClick={() => navigate('/operator/orders')} />
                <SidebarLink icon={<ChefHat size={18} />} label="Preparing" onClick={() => navigate('/operator/orders')} />
                <SidebarLink icon={<CheckCircle2 size={18} />} label="Ready" onClick={() => navigate('/operator/orders')} />
                <SidebarLink icon={<FileText size={18} />} label="All Orders" onClick={() => navigate('/operator/orders')} />
              </div>
            </div>

            <div>
              <p className="px-3 text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Receipts</p>
              <div className="space-y-1">
                <SidebarLink icon={<Printer size={18} />} label="Printed Receipts" onClick={() => navigate('/operator/receipts/printed')} />
                <SidebarLink icon={<FileText size={18} />} label="Receipt Settings" active onClick={() => navigate('/operator/receipt-settings')} />
              </div>
            </div>

            <div>
              <p className="px-3 text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Other</p>
              <div className="space-y-1">
                <SidebarLink icon={<FileSpreadsheet size={18} />} label="Reports" onClick={() => navigate('/operator/reports')} />
                <SidebarLink icon={<MessageSquare size={18} />} label="Chats" onClick={() => navigate('/notifications')} />
                <SidebarLink icon={<User size={18} />} label="My Account" onClick={() => navigate('/account')} />
              </div>
            </div>
          </nav>
        </div>

        <div className="p-4 border-t border-slate-800">
          <button onClick={() => { navigate('/login') }} className="flex items-center gap-3 px-3 py-2.5 text-red-400 hover:bg-red-950/30 rounded-lg font-medium transition w-full">
            <LogOut size={18} /> Logout
          </button>
        </div>
      </aside>

      {/* MAIN CONTENT */}
      <div className="flex-1 flex flex-col h-screen overflow-hidden">
        <header className="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 shrink-0">
          <div className="flex items-center gap-4">
            <button className="text-slate-500 hover:text-slate-700">
              <Menu size={20} />
            </button>
            <h1 className="text-lg font-semibold text-slate-900">Receipt Settings</h1>
          </div>
          <div className="flex items-center gap-6">
            <div className="flex items-center gap-3 border-l pl-6 border-slate-200">
              <div className="w-9 h-9 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-bold text-sm">
                OP
              </div>
              <div className="text-left">
                <p className="text-sm font-semibold text-slate-900 leading-tight">Operator</p>
                <p className="text-xs text-emerald-500 flex items-center gap-1"><span className="w-1.5 h-1.5 bg-emerald-500 rounded-full inline-block"></span> Online</p>
              </div>
            </div>
          </div>
        </header>

        <main className="flex-1 overflow-y-auto p-6">
          <div className="flex items-center justify-between mb-4">
            <div>
              <h2 className="text-xl font-bold text-slate-900">Receipt Display Settings</h2>
              <p className="text-sm text-slate-500 mt-1">Choose which fields are shown on the printed receipt.</p>
            </div>
            <div className="flex items-center gap-2">
              {saved && (
                <span className="text-xs font-bold text-emerald-600 bg-emerald-50 border border-emerald-200 rounded-lg px-3 py-1.5">
                  ✓ Settings saved
                </span>
              )}
              <button
                onClick={handleSave}
                disabled={saving}
                className="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm rounded-lg px-5 py-2.5 shadow-sm transition disabled:opacity-50"
              >
                <Save size={16} />
                {saving ? 'Saving...' : 'Save Settings'}
              </button>
            </div>
          </div>

          <div className="space-y-4">
            {SETTING_GROUPS.map((group) => (
              <div key={group.label} className="bg-white border border-slate-200 rounded-xl shadow-sm">
                <div className="px-5 py-3 border-b border-slate-100">
                  <h3 className="font-bold text-sm text-slate-900">{group.label}</h3>
                </div>
                <div className="p-5 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                  {group.settings.map((s) => (
                    <button
                      key={s.key}
                      type="button"
                      onClick={() => toggle(s.key)}
                      className={`flex items-center justify-between rounded-lg border px-4 py-3 text-left transition ${
                        settings[s.key]
                          ? 'border-emerald-300 bg-emerald-50/60 hover:bg-emerald-50'
                          : 'border-slate-200 bg-slate-50/60 hover:bg-slate-50'
                      }`}
                    >
                      <span className="text-sm font-semibold text-slate-800">{s.label}</span>
                      <span className={`relative inline-flex h-6 w-11 items-center rounded-full transition ${settings[s.key] ? 'bg-emerald-500' : 'bg-slate-300'}`}>
                        <span className={`inline-block h-4 w-4 transform rounded-full bg-white transition ${settings[s.key] ? 'translate-x-6' : 'translate-x-1'}`} />
                      </span>
                    </button>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <div className="mt-6 flex items-center justify-end gap-2 pb-6">
            <button
              onClick={() => navigate('/operator/receipts/printed')}
              className="flex items-center gap-2 border border-slate-200 text-slate-600 font-bold text-sm bg-white rounded-lg px-5 py-2.5 hover:bg-slate-50 shadow-sm transition"
            >
              <ArrowLeft size={16} /> Back to Receipts
            </button>
          </div>
        </main>
      </div>
    </div>
  )
}