# MTN MoMo Collection API (Rwanda)
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=

# MTN MoMo Disbursement API (requires separate product credentials)
MTN_MOMO_DISBURSEMENT_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=

# Airtel Money Open API (Rwanda)
AIRTEL_MONEY_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_COUNTRY=RW
AIRTEL_MONEY_CURRENCY=RWF

# Use production URLs and approved credentials only after provider onboarding.
# The Airtel account must have the disbursement product enabled for payouts.
MOMO_TIMEOUT_MS=15000

# Frontend workspace hosting
# Configure the frontend build with VITE_WORKSPACE_DOMAIN=your-app.com.
# Add a wildcard DNS record: *.your-app.com -> the frontend hosting target.
FRONTEND_URL=https://your-public-app.example
