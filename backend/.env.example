# Mobile Money (Momo) configuration
MOMO_BASE_URL=https://sandbox.momopayment.example
MOMO_API_KEY=your_momo_api_key
MOMO_API_SECRET=your_momo_api_secret
MOMO_PARTNER_ID=your_partner_id
MOMO_CALLBACK_URL=https://your-app.example.com/api/payments/momo/callback
MOMO_WEBHOOK_SECRET=your_webhook_secret
MOMO_TIMEOUT_MS=15000

# Frontend workspace hosting
# Configure the frontend build with VITE_WORKSPACE_DOMAIN=your-app.com.
# Add a wildcard DNS record: *.your-app.com -> the frontend hosting target.
